FoamFile
{
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Generated per case by morph/run_case.py (@...@ placeholders are filled in).
#includeEtc "caseDicts/mesh/generation/snappyHexMeshDict.cfg"

castellatedMesh on;
snap            on;
addLayers       on;

geometry
{
    body       { type triSurfaceMesh; file "body.stl"; }
    wheelFront { type triSurfaceMesh; file "wheelFront.stl"; }
    wheelRear  { type triSurfaceMesh; file "wheelRear.stl"; }
    mirror     { type triSurfaceMesh; file "mirror.stl"; }
    upstream   { type searchableBox; min (-10 0 0);   max ( 4.0 1.6 0.8); }
    underbody  { type searchableBox; min (-1  0 0);   max ( 5.0 1.2 0.18); }
    wake       { type searchableBox; min ( 3.8 0 0);  max ( 8.0 1.3 1.8); }
    downstream { type searchableBox; min ( 3.8 0 0);  max (30   1.8 2.2); }
};

castellatedMeshControls
{
    features
    (
        { file "body.eMesh"; level 5; }
        { file "wheelFront.eMesh"; level 5; }
        { file "wheelRear.eMesh"; level 5; }
        { file "mirror.eMesh"; level 5; }
    );

    refinementSurfaces
    {
        body       { level (5 5); patchInfo { type wall; } }
        wheelFront { level (4 5); patchInfo { type wall; } }
        wheelRear  { level (4 5); patchInfo { type wall; } }
        mirror     { level (5 6); patchInfo { type wall; } }
    }

    refinementRegions
    {
        body                { mode distance; levels ((0.15 5)); }
        "(wake|underbody)"  { mode inside;   level 4; }
        ".*stream"          { mode inside;   level 3; }
    }

    insidePoint (-5 3 4);
    nCellsBetweenLevels 4;
    maxLocalCells 2000000;
}

snapControls
{
    explicitFeatureSnap    true;
    implicitFeatureSnap    false;
}

addLayersControls
{
    layers
    {
        "(body|mirror)" { nSurfaceLayers 2; }
    }
    relativeSizes       on;
    expansionRatio      1.2;
    finalLayerThickness 0.5;
    minThickness        0.1;
    maxThicknessToMedialRatio 0.6;
}

writeFlags ();
mergeTolerance 1e-6;
