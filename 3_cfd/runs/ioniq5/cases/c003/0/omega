omegaInlet      30;
dimensions      [0 0 -1 0 0 0 0];
internalField   uniform $omegaInlet;
boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    inlet       { type fixedValue; value uniform $omegaInlet; }
    "(outlet|freestream)" { type inletOutlet; inletValue uniform $omegaInlet; value uniform $omegaInlet; }
    "(ground|body|mirror|wheel.*)" { type omegaWallFunction; value uniform $omegaInlet; }
}
