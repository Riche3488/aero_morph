# --- general ---
__pycache__/
*.pyc
.claude/scheduled_tasks.lock

# --- gen3d (photo -> 3D car pipeline) ---
gen3d/.venv/
# upstream TRELLIS clone (see gen3d/README.md "Setup")
gen3d/TRELLIS/
# first-session scratch inputs
gen3d/inputs/
# first-session outputs: keep only the raw mesh imported by vehicles/ioniq5.yaml
gen3d/output/*
!gen3d/output/ioniq5_final_raw.ply
# pipeline runs: keep reports / attribution / final + rough meshes / previews only
gen3d/runs/_search/
gen3d/runs/*/candidates/
gen3d/runs/*/inputs/
gen3d/runs/*/*.obj
gen3d/runs/*/*_inspect.png

# --- Windows download / copy artefacts ---
*:Zone.Identifier

# --- stage 1/2: geometry that the scripts regenerate (ioniq5_geometry.py, export_designs.py) ---
1_vehicle_geometry/output/*.stl
2_shape_morphing/studies/*/geometry/**/*.stl

# --- stage 3: OpenFOAM data regenerated by run_case.py / Allrun ---
3_cfd/**/processor*/
3_cfd/**/dynamicCode/
3_cfd/**/constant/polyMesh/
3_cfd/**/constant/extendedFeatureEdgeMesh/
3_cfd/**/constant/geometry/
3_cfd/runs/.geometry_hash_cache.json
# field samples (surfaces / planes) are large; force coefficient histories are kept
3_cfd/**/postProcessing/*
!3_cfd/**/postProcessing/force*
